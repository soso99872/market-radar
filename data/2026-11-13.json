 "key_points": [
  { "title": "輝達董事會調查黃仁勳,AI龍頭領導風險拖累費半與那斯達克",
    "detail": "NVDA 股價單日重挫 5.72% 至 163.79 美元,費城半導體指數同步下跌 1.0%,那斯達克跌 0.56%。輝達董事會已委任外部律師調查執行長黃仁勳是否遭外國情報目標接觸、以及其婚外情案,公司強調黃仁勳仍續任執行長、無證據顯示機密外洩,但市場仍擔憂AI領導層出現真空風險。若調查延長或牽動人事變動,AI供應鏈(含先進封裝、AI伺服器代工)評價可能進一步承壓;若董事會迅速釐清並重申支持,情緒可望緩和。",
    "impact": "利空", "market": "台美股", "sectors": ["半導體", "AI 伺服器"] },
  { "title": "美國10月CPI超預期,降息預期轉為升息風險,殖利率與美元走揚",
    "detail": "10月CPI於11/10公布,核心CPI月增0.3%(預期0.2%)、總體月增0.4%(預期0.3%),為連續偏熱。市場對12月8-9日FOMC會議的升息機率上升至約八成,美國10年期公債殖利率彈升至5.103%(+2.1%),美元指數升至103.17。若今晚(台北時間11/13 21:30)公布的10月生產者物價指數(PPI)同樣偏熱,殖利率與美元可能進一步走升,壓抑成長股與新興市場資金;若數據降溫,則有助緩解升息疑慮。",
    "impact": "利空", "market": "美股", "sectors": [] },
  { "title": "台股回吐漲幅、仍處季線下方,外資與自營商同步賣超晶片股",
    "detail": "加權指數11/11大漲3.62%至44257點後,11/12收跌2.63%至43091.87點,回吐多數漲幅,官方籌碼資料顯示指數目前仍在60日均線之下。11/12外資賣超6.85億元、自營商賣超65.41億元,僅投信買超125.68億元,三大法人合計買超53.42億元。半導體相關板塊(晶圓代工、IC設計、AI先進封裝、電源供應、半導體廠務與設備)20日資金動能同時排名31個板塊最後段,台積電20日遭法人賣超逾3058億元,即便10月營收年增近60%,顯示資金仍在撤出晶片供應鏈。",
    "impact": "利空", "market": "台股", "sectors": ["晶圓代工", "IC設計", "AI先進封裝"] },
  { "title": "資金轉向電信、航運、金融等板塊",
    "detail": "板塊資金流向資料顯示,電信(31個板塊中排名第1)、航運(排名第4)、金融(排名第5)為近20日法人資金流入前段班,中華電、長榮航、華航、合庫金、兆豐金等個股出現法人連續買超與股價創高紀錄。此為歷史籌碼統計事實,不代表未來股價走勢保證。",
    "impact": "中性", "market": "台股", "sectors": ["電信", "航運", "金融"] },
  { "title": "台灣10月出口創新高,但央行示警資金外流同步擴大",
    "detail": "財政部11/9公布10月出口967.6億美元,年增58.9%,連續36個月正成長,單月出超278.8億美元同創新高,主因資通與視聽產品及電子零組件訂單強勁。然而央行同時指出10月外資淨匯出(含股息匯出)約280億美元,創單月新高,出口基本面強勢與資金流向出現背離,新台幣兌美元同步走貶至32.991(+0.11%)。",
    "impact": "視數據而定", "market": "台股", "sectors": [] },
  { "title": "起漲雷達:10月營收創新高與爆量突破股票歷史證據強度「強」",
    "detail": "雷達資料顯示,10月營收創12個月新高且高成長的個股共191檔,歷史回測20日平均相對報酬+1.92%、60日+4.71%,證據強度「強」;另有5檔個股近期爆量突破創52週新高,60日平均相對報酬+3.8%,證據強度同樣「強」,但勝率僅約43-46%,顯示個股分化明顯。此為歷史統計事實,非個股買賣建議。",
    "impact": "中性", "market": "台股", "sectors": [] },
  { "title": "VIX與商品市場同步反映避險情緒升溫",
    "detail": "VIX恐慌指數單日跳升6.86%至18.69,黃金重挫2.78%至每英兩3889.2美元、比特幣下跌3.41%至71438.9美元,顯示部分資金在風險資產與傳統避險資產同步撤出,轉向美元與現金;WTI原油逆勢上漲2.89%至89.03美元,反映地緣政治與供給面因素仍在發酵。",
    "impact": "視數據而定", "market": "美股", "sectors": [] }
 ],
