 "key_points": [
  { "title": "美股科技股從上週重挫反彈,VIX明顯回落",
    "detail": "美股收盤那斯達克大漲1.25%、費半漲1.95%,領漲美股;VIX恐慌指數大跌7.8%至18.43,較上週高點明顯降溫。此次反彈被歸因於記憶體等科技股從上週的AI基建信心疑慮中回穩;若反彈能延續,代表市場暫時消化完上週的恐慌性賣壓,風險偏好回升,對台股電子權值股為利多;若後續個股財報或數據再度令市場失望,则可能只是技術性反彈,恐再引發波動。",
    "impact": "利多", "market": "美股", "sectors": ["半導體", "科技股"] },
  { "title": "上週AI基建信心疑慮的源頭:CPI數據偏高、台積電2027展望保守",
    "detail": "上週那斯達克指數重挫、費半七個交易日跌掉逾14%(市值蒸發約2兆美元),主要觸發點是10/14公布的9月CPI高於預期,升高市場對Fed政策維持偏鷹的擔憂;台積電10/15法說會對2027年資本支出態度保守,以及雲端資料中心業者CoreWeave股價重挫、相關企業債利差擴大,進一步放大AI供應鏈信心疑慮。此脈絡若延續,高於預期的通膨或企業財報中對AI資本支出保守的措辭,都可能再度衝擊半導體與伺服器概念股;若本週數據與財報偏正面,則有助情緒進一步修復。",
    "impact": "視數據而定", "market": "美台股", "sectors": ["半導體", "AI伺服器", "晶圓代工"] },
  { "title": "台股三大法人10/19大舉賣超888.6億元、新台幣同步走貶",
