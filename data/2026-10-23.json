  "key_points": [
    { "title": "科磊供應警訊引爆AI晶片股全面拋售,費半創波段最大單日跌幅",
      "detail": "晶圓設備廠科磊(Lam Research)釋出供應受限的保守展望,觸發AI晶片供應鏈全面殺盤:Marvell、AMD盤中跌約8%,英特爾跌約7%,科磊本身重挫約9%,費城半導體指數單日重挫6.06%,為6月下旬以來最大單日跌幅;那斯達克綜合指數跌2.44%,創6月以來最差單日表現。市場同時對AI資本支出能否帶來對等回報的疑慮再度升溫。若今日台北開盘後,AI供應鏈情緒延續偏空,台股晶圓代工、ASIC、AI伺服器等出口相關個股恐面臨補跌壓力;若美股尾盤止穩或出現逢低買盤,台股跌幅則可能收斂。",
      "impact": "利空", "market": "美股", "sectors": ["半導體", "AI伺服器", "ASIC 與矽智財"] },
    { "title": "台積電ADR暴跌4.63%,對台北現股溢價收窄至10.94%",
      "detail": "台積電ADR(TSM)隨美股半導體全面重挫同步下跌4.63%,收411.89美元,較台北現股(10/21收2420元)溢價由前一日的高檔收窄至10.94%。傳導路徑為:美股費半重挫→台積電ADR領跌→台北開盘時台積電現股及晶圓代工、設備族群情緒承壓;若溢價持續收斂,代表外資在美盤的賣壓已超過台北現股的既有估值,台股開盘補跌風險隨之上升。",
      "impact": "利空", "market": "台美股", "sectors": ["半導體", "晶圓代工"] },
    { "title": "風險資產與避險資產同步下跌,顯示市場出現去風險(deleveraging)跡象",
      "detail": "VIX恐慌指數單日急升15.11%至19.2,同時美10年債殖利率下跌3.52個基點、美元指數小跌0.23%,但黃金重挫2.16%、比特幣下跌3.21%。殖利率與美元走弱卻未能撐住黃金與比特幣,顯示本輪賣壓較可能是資金全面減碼風險部位、回補保證金所致,而非單純轉向傳統避險資產;若去風險情緒持續擴大,新興市場與台股等風險資產仍可能承壓,反之若VIX回落,資金可能重新分散配置。",
      "impact": "利空", "market": "美股", "sectors": [] },
    { "title": "台股三大法人前一交易日大舉賣超994.67億元,外資為主要賣壓",
      "detail": "10/22三大法人合計賣超994.67億元,其中外資賣超815.82億元、自營商賣超273.77億元,僅投信逆勢買超94.92億元。法人轉趨保守的態度與隔夜美股AI晶片鏈重挫的氣氛相呼應;若外資今日持續調節,台股開盘量能與情緒恐進一步受壓,投信逆勢買超的防禦性佈局則可能提供部分緩衝。",
      "impact": "利空", "market": "台股", "sectors": [] },
    { "title": "外資台指期淨空單維持相對高檔,官方最新資料僅至10/13",
      "detail": "據財經媒體整理,外資台指期未平倉淨空單在10/13約為8.7萬口,處於9月下旬以來的相對高檔區間(7.6萬至8.7萬口),但期交所官方資料目前僅更新至該日,尚無法確認10/22當日的期貨籌碼變化。若外資於隔夜美股重挫後同步在台指期加碼空單,台股開盘上方賣壓恐增加;若外資轉為回補空單,則可能減緩下跌動能。",
      "impact": "視數據而定", "market": "台股", "sectors": [] },
    { "title": "本週聚焦FOMC利率決議與美國GDP、PCE物價數據,科技巨頭財報週同步登場",
      "detail": "美國聯準會將於10/27-28召開FOMC會議,利率決議約於台北時間10/29凌晨公布;同日稍晚(台北時間10/29晚間20:30)將公布美國第三季GDP初值與9月PCE物價指數。市場先前在Fed主席Warsh於Jackson Hole發表偏鷹言論後,一度將9月升息機率由34%上修至54%,目前聯邦資金利率區間約為3.75%至4.00%。若PCE通膀數據高於預期或FOMC決議偏鷹,將強化再升息預期,推升美元與殖利率,對科技成長股估值形成壓力;若數據降溫或Fed維持不變,風險情緒可望緩和。此外,Meta、蘋果等美股大型科技公司預計於本週(約10/28-10/29前後)密集公布財報,AI資本支出指引能否說服市場將是觀察重點。",
      "impact": "視數據而定", "market": "美股", "sectors": ["AI", "科技股"] },
    { "title": "板塊資金呈現防禦輪動,晶圓代工連續12日遭資金撤出",
      "detail": "據板塊資金流資料,電信、鋼鐵、航運、金融等板塊20日法人資金持續淨流入,其中電信20日淨流入184億元、資金排名全市場31個板塊中第1,金融淨流入437億元排名第4;相對地,晶圓代工連續12日遭資金淨流出,20日累計淨流出3450億元,外資在台積電等權值股的賣壓最為明顯。此現象僅為事實陳述,反映近期AI急殺後資金階段性轉往傳統內需或高息板塊,若隔夜美股晶片股賣壓延續,晶圓代工資金流出狀態可能持續;若AI鏈情緒回穩,資金亦可能重新流入。",
      "impact": "中性", "market": "台股", "sectors": ["電信", "金融", "鋼鐵", "晶圓代工"] }
  ],
